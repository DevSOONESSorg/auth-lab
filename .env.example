# このファイルを .env という名前でコピーして使います（.env はGitに入りません）

# ---- web（ログイン教材アプリ） ----
WEB_PORT=4000
# セッションIDの署名に使う秘密の文字列。本番では長いランダム文字列にする
SESSION_SECRET=change-me-session-secret

# ---- api（社員マスタAPI） ----
API_PORT=4001
# APIの認証方式: none / apikey / jwt   ← 第3段でここを切り替える
API_AUTH_MODE=none
# apikey 方式のときの鍵
API_KEY=demo-api-key-12345
# jwt 方式のときの「クライアントID / シークレット」（webがトークンをもらうときに使う）
API_CLIENT_ID=bihin-web
API_CLIENT_SECRET=demo-client-secret
# JWTの署名に使う秘密の文字列
JWT_SECRET=change-me-jwt-secret
# JWTの有効期限（例: 60s, 10m, 1h）
JWT_EXPIRES_IN=10m
